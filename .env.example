# Configuration reference; the application does not load this file automatically.
# HTTP(S) base URL; a path prefix is supported.
MILKY_URL=http://127.0.0.1:3010/

# Optional Milky access token
MILKY_ACCESS_TOKEN=

# debug, info, warn, error
LOG_LEVEL=info

# Comma-separated, non-empty command prefixes; quote values containing #.
COMMAND_PREFIXES="/,#"
